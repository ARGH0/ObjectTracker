<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ObjectTracker.UI.Desktop"
             xmlns:vm="clr-namespace:ObjectTracker.UI.Desktop.ViewModels"
             x:Class="ObjectTracker.UI.Desktop.CameraWorkspace"
             x:DataType="vm:CameraWorkspaceViewModel">

    <Grid RowDefinitions="*,Auto">
        <SplitView x:Name="CameraSplitView"
                   Grid.Row="0"
                   OpenPaneLength="{Binding OpenPaneLength}"
                   CompactPaneLength="{Binding CompactPaneLength}"
                   DisplayMode="{Binding DisplayMode}"
                   IsPaneOpen="{Binding IsPaneOpen}"
                   UseLightDismissOverlayMode="True">
            <SplitView.Pane>
                <Border x:Name="CameraPanelBorder"
                        Classes="surface"
                        Padding="10">
                    <Grid RowDefinitions="Auto,8,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,8,Auto,8,Auto">
                            <TextBlock x:Name="CameraPanelTitleText"
                                       Grid.Column="0"
                                       Text="Camera Sources"
                                       Classes="sectionTitle"
                                       IsVisible="{Binding IsPanelVisible}" />
                            <Button x:Name="ToggleCameraPanelButton"
                                    Grid.Column="2"
                                    Classes="ghost"
                                    Content="{Binding ToggleButtonText}"
                                    Command="{Binding TogglePaneCommand}"
                                    IsVisible="{Binding IsToggleButtonVisible}" />
                            <Button x:Name="PinCameraPanelButton"
                                    Grid.Column="4"
                                    Classes="ghost"
                                    Content="{Binding PinButtonText}"
                                    Command="{Binding PinPaneCommand}"
                                    IsVisible="{Binding IsPinButtonVisible}" />
                        </Grid>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid x:Name="CameraPanelFullContent"
                                  RowDefinitions="Auto,8,*"
                                  IsVisible="{Binding IsPanelVisible}">
                                <ListBox Grid.Row="0"
                                         x:Name="CameraSourceListBox"
                                         SelectionMode="Single"
                                         MinHeight="150"
                                         MaxHeight="220">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem x:Name="DeleteSelectedCameraMenuItem"
                                                      Header="Delete Camera" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                </ListBox>

                                <Grid Grid.Row="2"
                                      RowDefinitions="Auto,8,Auto,8,Auto,8,*">
                                    <Grid Grid.Row="0"
                                          ColumnDefinitions="*,6,*">
                                        <Button x:Name="AddVideosButton"
                                                Grid.Column="0"
                                                Classes="primary"
                                                Content="Add Camera" />
                                        <Button x:Name="RemoveSelectedButton"
                                                Grid.Column="2"
                                                Classes="destructive"
                                                Content="Remove" />
                                    </Grid>

                                    <Grid Grid.Row="1"
                                          ColumnDefinitions="*,6,*">
                                        <Button x:Name="MoveCameraUpButton"
                                                Grid.Column="0"
                                                Classes="ghost"
                                                Content="Move Up" />
                                        <Button x:Name="MoveCameraDownButton"
                                                Grid.Column="2"
                                                Classes="ghost"
                                                Content="Move Down" />
                                    </Grid>

                                    <Border Grid.Row="4"
                                            Classes="surfaceAlt"
                                            Padding="10">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Camera Zone"
                                                       Classes="sectionTitle" />
                                            <TextBlock Text="Bind selected source to a stable Camera Zone"
                                                       Classes="muted"
                                                       TextWrapping="Wrap" />
                                            <CheckBox x:Name="CameraVisibilityCheckBox"
                                                      Content="Camera Visibility"
                                                      IsChecked="True" />
                                            <CheckBox x:Name="VisionPipelineInclusionCheckBox"
                                                      Content="Vision Pipeline Inclusion"
                                                      IsChecked="True" />
                                            <CheckBox x:Name="CameraDebugViewCheckBox"
                                                      Content="Debug View"
                                                      IsChecked="False" />
                                            <TextBlock x:Name="UsbCameraSourceStatusText"
                                                       Classes="muted"
                                                       Text="USB Camera Source: -"
                                                       TextWrapping="Wrap" />
                                            <Button x:Name="RestartUsbCameraSourceButton"
                                                    Classes="ghost"
                                                    Content="Restart Camera Source" />
                                            <StackPanel x:Name="UsbCaptureSettingsPanel"
                                                        Spacing="6"
                                                        IsVisible="False">
                                                <TextBlock Text="USB Capture Settings"
                                                           Classes="sectionTitle" />
                                                <ComboBox x:Name="UsbResolutionComboBox" />
                                                <ComboBox x:Name="UsbTargetFpsComboBox" />
                                                <TextBlock x:Name="UsbCaptureModeStatusText"
                                                           Classes="muted"
                                                           TextWrapping="Wrap" />
                                                <Grid ColumnDefinitions="*,8,*">
                                                    <Button x:Name="ApplyUsbCaptureSettingsButton"
                                                            Grid.Column="0"
                                                            Classes="primary"
                                                            Content="Apply" />
                                                    <Button x:Name="RevertUsbCaptureSettingsButton"
                                                            Grid.Column="2"
                                                            Classes="ghost"
                                                            Content="Revert" />
                                                </Grid>
                                            </StackPanel>
                                            <ComboBox x:Name="CameraZoneComboBox" />
                                            <Button x:Name="ToggleGridEditorButton"
                                                    Classes="ghost"
                                                    Content="Open Grid Region Editor" />

                                            <StackPanel x:Name="GridEditorPanel"
                                                        Spacing="6"
                                                        IsVisible="False">
                                                <TextBlock Text="Grid Region Editor"
                                                           Classes="sectionTitle"
                                                           Margin="0,8,0,0" />
                                                <ComboBox x:Name="LayerTypeComboBox" />
                                                <Grid ColumnDefinitions="*,8,*">
                                                    <Button x:Name="AddLayerButton"
                                                            Grid.Column="0"
                                                            Classes="ghost"
                                                            Content="Add Layer" />
                                                    <Button x:Name="DeleteLayerButton"
                                                            Grid.Column="2"
                                                            Classes="ghost"
                                                            Content="Delete Layer" />
                                                </Grid>
                                                <ListBox x:Name="LayersListBox"
                                                         MinHeight="70"
                                                         MaxHeight="120" />
                                                <ListBox x:Name="RegionsListBox"
                                                         MinHeight="70"
                                                         MaxHeight="120" />
                                                <TextBox x:Name="RegionNameTextBox"
                                                         Watermark="Region name" />
                                                <TextBox x:Name="RegionCodeTextBox"
                                                         Watermark="Region code (optional)" />
                                                <TextBox x:Name="RegionCellsTextBox"
                                                         Watermark="Cells: 1,1;2,1" />
                                                <Grid ColumnDefinitions="*,8,*">
                                                    <Button x:Name="SaveRegionButton"
                                                            Grid.Column="0"
                                                            Classes="primary"
                                                            Content="Save Region" />
                                                    <Button x:Name="DeleteRegionButton"
                                                            Grid.Column="2"
                                                            Classes="ghost"
                                                            Content="Delete Region" />
                                                </Grid>
                                                <Button x:Name="RefreshCompositionPreviewButton"
                                                        Classes="ghost"
                                                        Content="Refresh Composition Preview" />
                                                <ListBox x:Name="CompositionPreviewListBox"
                                                         MinHeight="80"
                                                         MaxHeight="140" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="6"
                                            Classes="surfaceAlt"
                                            Padding="10">
                                        <Grid RowDefinitions="Auto,6,*,8,Auto">
                                            <StackPanel Grid.Row="0" Spacing="2">
                                                <TextBlock Text="Processing"
                                                           Classes="sectionTitle" />
                                                <TextBlock Text="Compact runtime tuning for selected camera"
                                                           Classes="muted"
                                                           TextWrapping="Wrap" />
                                                <DockPanel LastChildFill="False" Margin="0,2,0,0">
                                                    <Border Background="#26323B"
                                                            BorderBrush="#3C4F5E"
                                                            BorderThickness="1"
                                                            Padding="4,1"
                                                            Margin="0,0,6,0">
                                                        <TextBlock Text="i"
                                                                   Foreground="#CFE0EC"
                                                                   FontSize="11"
                                                                   FontWeight="Bold" />
                                                    </Border>
                                                    <TextBlock Text="Hover labels for parameter help"
                                                               Classes="muted"
                                                               FontSize="11"
                                                               VerticalAlignment="Center" />
                                                </DockPanel>
                                            </StackPanel>

                                            <ScrollViewer Grid.Row="2"
                                                          VerticalScrollBarVisibility="Auto">
                                                <StackPanel Spacing="8">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <CheckBox x:Name="LoopVideoCheckBox"
                                                                  Content="Loop this video source"
                                                                  IsChecked="True" />
                                                        <Border Background="#26323B"
                                                                BorderBrush="#3C4F5E"
                                                                BorderThickness="1"
                                                                Padding="4,1"
                                                                ToolTip.Tip="When enabled, the selected video source restarts automatically after reaching the end."
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="i"
                                                                       Foreground="#CFE0EC"
                                                                       FontSize="11"
                                                                       FontWeight="Bold" />
                                                        </Border>
                                                    </StackPanel>

                                                    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto">
                                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="Samples"
                                                                           Classes="eyebrow" />
                                                                <Border Background="#26323B"
                                                                        BorderBrush="#3C4F5E"
                                                                        BorderThickness="1"
                                                                        Padding="4,1"
                                                                        ToolTip.Tip="Number of frames used to estimate the static background model. Higher values improve stability but increase startup time."
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="i"
                                                                               Foreground="#CFE0EC"
                                                                               FontSize="11"
                                                                               FontWeight="Bold" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBox x:Name="SampleCountTextBox" Text="20" Watermark="20" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="Bake Source"
                                                                           Classes="eyebrow" />
                                                                <Border Background="#26323B"
                                                                        BorderBrush="#3C4F5E"
                                                                        BorderThickness="1"
                                                                        Padding="4,1"
                                                                        ToolTip.Tip="Choose whether the background model is baked from sampled source frames or from a single image file."
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="i"
                                                                               Foreground="#CFE0EC"
                                                                               FontSize="11"
                                                                               FontWeight="Bold" />
                                                                </Border>
                                                            </StackPanel>
                                                            <ComboBox x:Name="BakeSourceComboBox"
                                                                      ToolTip.Tip="Source used to create the baked background mask for subtraction."
                                                                      SelectedIndex="0">
                                                                <ComboBoxItem Content="Samples from source" />
                                                                <ComboBoxItem Content="Image file" />
                                                            </ComboBox>
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Spacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="Bake Image"
                                                                           Classes="eyebrow" />
                                                                <Border Background="#26323B"
                                                                        BorderBrush="#3C4F5E"
                                                                        BorderThickness="1"
                                                                        Padding="4,1"
                                                                        ToolTip.Tip="Path to an image used as the background reference when Bake Source is set to Image file."
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="i"
                                                                               Foreground="#CFE0EC"
                                                                               FontSize="11"
                                                                               FontWeight="Bold" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBox x:Name="BakeImagePathTextBox"
                                                                     IsReadOnly="True"
                                                                     Watermark="No image selected" />
                                                            <Grid ColumnDefinitions="*,8,*">
                                                                <Button x:Name="SelectBakeImageButton"
                                                                        Grid.Column="0"
                                                                        Classes="ghost"
                                                                        ToolTip.Tip="Pick an image file to use as the baked background reference."
                                                                        Content="Select Image" />
                                                                <Button x:Name="ClearBakeImageButton"
                                                                        Grid.Column="2"
                                                                        Classes="ghost"
                                                                        ToolTip.Tip="Remove the currently selected baked image path."
                                                                        Content="Clear Image" />
                                                            </Grid>
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="4" Grid.Column="0" Spacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="Threshold"
                                                                           Classes="eyebrow" />
                                                                <Border Background="#26323B"
                                                                        BorderBrush="#3C4F5E"
                                                                        BorderThickness="1"
                                                                        Padding="4,1"
                                                                        ToolTip.Tip="Pixel-difference threshold for foreground detection. Lower values detect subtle motion; higher values ignore small changes/noise."
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="i"
                                                                               Foreground="#CFE0EC"
                                                                               FontSize="11"
                                                                               FontWeight="Bold" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBox x:Name="ThresholdTextBox" Text="100" Watermark="100" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="4" Grid.Column="2" Spacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="Motion Area"
                                                                           Classes="eyebrow" />
                                                                <Border Background="#26323B"
                                                                        BorderBrush="#3C4F5E"
                                                                        BorderThickness="1"
                                                                        Padding="4,1"
                                                                        ToolTip.Tip="Minimum contour/pixel area treated as valid motion. Increase to suppress tiny flicker and noise blobs."
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="i"
                                                                               Foreground="#CFE0EC"
                                                                               FontSize="11"
                                                                               FontWeight="Bold" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBox x:Name="MotionAreaTextBox" Text="220" Watermark="220" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="6" Grid.Column="0" Spacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="Color Pixels"
                                                                           Classes="eyebrow" />
                                                                <Border Background="#26323B"
                                                                        BorderBrush="#3C4F5E"
                                                                        BorderThickness="1"
                                                                        Padding="4,1"
                                                                        ToolTip.Tip="Minimum number of matched color pixels required before color-based detection is considered active."
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="i"
                                                                               Foreground="#CFE0EC"
                                                                               FontSize="11"
                                                                               FontWeight="Bold" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBox x:Name="ColorMinPixelsTextBox" Text="40" Watermark="40" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="6" Grid.Column="2" Spacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="Morph Kernel"
                                                                           Classes="eyebrow" />
                                                                <Border Background="#26323B"
                                                                        BorderBrush="#3C4F5E"
                                                                        BorderThickness="1"
                                                                        Padding="4,1"
                                                                        ToolTip.Tip="Kernel size for morphology (erode/dilate) cleanup. Larger kernels remove more speckle but can merge nearby regions."
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="i"
                                                                               Foreground="#CFE0EC"
                                                                               FontSize="11"
                                                                               FontWeight="Bold" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBox x:Name="MorphKernelSizeTextBox" Text="3" Watermark="3" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="Process Width"
                                                                       Classes="eyebrow" />
                                                            <Border Background="#26323B"
                                                                    BorderBrush="#3C4F5E"
                                                                    BorderThickness="1"
                                                                    Padding="4,1"
                                                                    ToolTip.Tip="Target frame width used for processing. Lower widths run faster; higher widths preserve detail at higher CPU cost."
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="i"
                                                                           Foreground="#CFE0EC"
                                                                           FontSize="11"
                                                                           FontWeight="Bold" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBox x:Name="ProcessWidthTextBox" Text="640" Watermark="640" />
                                                    </StackPanel>

                                                </StackPanel>
                                            </ScrollViewer>

                                            <Grid Grid.Row="4" ColumnDefinitions="*,8,*">
                                                <Button x:Name="OpenBakedMaskButton"
                                                        Grid.Column="2"
                                                        Classes="ghost"
                                                        Content="Open Baked Mask" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </SplitView.Pane>
            <SplitView.Content>
                <Border Classes="surface"
                        Padding="10">
                    <Grid RowDefinitions="Auto,8,Auto,8,*">
                        <Border Grid.Row="0"
                                Classes="surfaceAlt"
                                Padding="8">
                            <Grid ColumnDefinitions="*,8,*,Auto">
                                <TextBlock x:Name="CurrentVideoText"
                                           Grid.Column="0"
                                           Text="Current camera/source: -"
                                           VerticalAlignment="Center"
                                           Foreground="#E8F0F5"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="StatusText"
                                           Grid.Column="2"
                                           Text="Status: ready"
                                           Classes="muted"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                                <Grid Grid.Column="3"
                                      ColumnDefinitions="Auto,6,Auto,6,Auto">
                                    <Button Grid.Column="0"
                                            x:Name="PreviousVideoButton"
                                            Classes="ghost"
                                            Content="Previous" />
                                    <Button Grid.Column="2"
                                            x:Name="NextVideoButton"
                                            Classes="ghost"
                                            Content="Next" />
                                    <Button Grid.Column="4"
                                            x:Name="MarkAmbiguityButton"
                                            Classes="destructive"
                                            Content="Mark Ambiguity" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                x:Name="AmbiguityBanner"
                                Background="#4A1E25"
                                BorderBrush="#D17A86"
                                BorderThickness="1"
                                Padding="8"
                                IsVisible="False">
                            <Grid ColumnDefinitions="*,8,Auto,6,Auto,6,Auto,6,Auto">
                                <TextBlock x:Name="AmbiguityText"
                                           Grid.Column="0"
                                           Text="Ambiguity detected. Resolve before automatic processing continues."
                                           Foreground="#FFEDEE"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                                <Button x:Name="ResolveRemovedButton"
                                        Grid.Column="2"
                                        Classes="ghost"
                                        Content="Removed" />
                                <Button x:Name="ResolveRelinkButton"
                                        Grid.Column="4"
                                        Classes="ghost"
                                        Content="Relinked" />
                                <Button x:Name="ResolveFalseButton"
                                        Grid.Column="6"
                                        Classes="ghost"
                                        Content="False" />
                                <Button x:Name="ResolveOtherButton"
                                        Grid.Column="8"
                                        Classes="ghost"
                                        Content="Other" />
                            </Grid>
                        </Border>

                        <UniformGrid x:Name="CameraTileGrid"
                                     Grid.Row="4"
                                     Rows="2"
                                     Columns="2" />
                    </Grid>
                </Border>
            </SplitView.Content>
        </SplitView>

        <Expander x:Name="RuntimeLogExpander"
                  Grid.Row="1"
                  IsExpanded="False"
                  Header="Runtime Log"
                  Margin="0,8,0,0"
                  FontWeight="SemiBold">
            <ListBox x:Name="LogListBox"
                     Height="170"
                     FontFamily="Cascadia Mono"
                     FontSize="12" />
        </Expander>
    </Grid>
</UserControl>
