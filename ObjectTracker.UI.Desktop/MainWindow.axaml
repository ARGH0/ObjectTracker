<wnd:AppWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:wnd="using:FluentAvalonia.UI.Windowing"
               mc:Ignorable="d"
               x:Class="ObjectTracker.UI.Desktop.MainWindow"
               Title="ObjectTracker"
               Width="1920"
               Height="1080"
               MinWidth="1080"
               MinHeight="680"
               d:DesignWidth="1920"
               d:DesignHeight="1080">
    <Grid RowDefinitions="40,*,Auto"
          Margin="10,0,10,10">

        <!-- Compact title bar / branding strip -->
        <Border Grid.Row="0" wnd:AppWindow.AllowInteractionInTitleBar="False">
            <Menu DockPanel.Dock="Right"
                  Margin="0,0,12,0"
                  VerticalAlignment="Center"
                  Background="Transparent">
                <MenuItem Header="Camera"
                          x:Name="CameraWorkspaceMenuItem">
                    <MenuItem Header="Open Workspace"
                              x:Name="OpenCameraWorkspaceMenuItem" />
                    <MenuItem Header="Clear Cameras"
                              x:Name="ClearCamerasMenuItem" />
                </MenuItem>
                <MenuItem Header="Layers"
                          x:Name="LayersWorkspaceMenuItem" />
                <MenuItem Header="Settings"
                          x:Name="SettingsWorkspaceMenuItem" />
                <MenuItem Header="Vision Pipeline"
                          x:Name="VisionPipelineMenuItem">
                    <MenuItem Header="Start"
                              x:Name="StartVisionPipelineMenuItem" />
                    <MenuItem Header="Stop"
                              x:Name="StopVisionPipelineMenuItem" />
                </MenuItem>
            </Menu>
        </Border>

        <Grid x:Name="CameraWorkspacePanel"
              Grid.Row="1"
              RowDefinitions="*,Auto">
            <SplitView x:Name="CameraSplitView"
                       Grid.Row="0"
                       OpenPaneLength="340"
                       CompactPaneLength="0"
                       DisplayMode="Inline"
                       IsPaneOpen="True"
                       UseLightDismissOverlayMode="True">
                <SplitView.Pane>
                    <Border x:Name="CameraPanelBorder"
                            Classes="surface"
                            Padding="10">
                <Grid RowDefinitions="Auto,8,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,8,Auto,8,Auto">
                        <TextBlock x:Name="CameraPanelTitleText"
                                   Grid.Column="0"
                                   Text="Camera Sources"
                                   Classes="sectionTitle" />
                        <Button x:Name="ToggleCameraPanelButton"
                                Grid.Column="2"
                                Classes="ghost"
                                Content="Hide" />
                        <Button x:Name="PinCameraPanelButton"
                                Grid.Column="4"
                                Classes="ghost"
                                Content="📌" />
                    </Grid>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="CameraPanelFullContent"
                          RowDefinitions="Auto,8,*">
                    <ListBox Grid.Row="0"
                              x:Name="CameraSourceListBox"
                              SelectionMode="Single"
                              MinHeight="150"
                              MaxHeight="220">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="DeleteSelectedCameraMenuItem"
                                          Header="Delete Camera" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <Grid Grid.Row="2"
                          RowDefinitions="Auto,8,Auto,8,Auto,8,*">
                        <Grid Grid.Row="0"
                              ColumnDefinitions="*,6,*">
                            <Button x:Name="AddVideosButton"
                                    Grid.Column="0"
                                    Classes="primary"
                                    Content="Add Camera" />
                            <Button x:Name="RemoveSelectedButton"
                                    Grid.Column="2"
                                    Classes="destructive"
                                    Content="Remove" />
                        </Grid>

                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,6,*">
                            <Button x:Name="MoveCameraUpButton"
                                    Grid.Column="0"
                                    Classes="ghost"
                                    Content="Move Up" />
                            <Button x:Name="MoveCameraDownButton"
                                    Grid.Column="2"
                                    Classes="ghost"
                                    Content="Move Down" />
                        </Grid>

                        <Border Grid.Row="4"
                                Classes="surfaceAlt"
                                Padding="10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Camera Zone"
                                           Classes="sectionTitle" />
                                <TextBlock Text="Bind selected source to a stable Camera Zone"
                                           Classes="muted"
                                           TextWrapping="Wrap" />
                                <CheckBox x:Name="CameraVisibilityCheckBox"
                                          Content="Camera Visibility"
                                          IsChecked="True" />
                                <CheckBox x:Name="VisionPipelineInclusionCheckBox"
                                          Content="Vision Pipeline Inclusion"
                                          IsChecked="True" />
                                 <CheckBox x:Name="CameraDebugViewCheckBox"
                                           Content="Debug View"
                                           IsChecked="False" />
                                <TextBlock x:Name="UsbCameraSourceStatusText"
                                           Classes="muted"
                                           Text="USB Camera Source: -"
                                           TextWrapping="Wrap" />
                                <Button x:Name="RestartUsbCameraSourceButton"
                                        Classes="ghost"
                                        Content="Restart Camera Source" />
                                <StackPanel x:Name="UsbCaptureSettingsPanel"
                                            Spacing="6"
                                            IsVisible="False">
                                    <TextBlock Text="USB Capture Settings"
                                               Classes="sectionTitle" />
                                    <ComboBox x:Name="UsbResolutionComboBox" />
                                    <ComboBox x:Name="UsbTargetFpsComboBox" />
                                    <TextBlock x:Name="UsbCaptureModeStatusText"
                                               Classes="muted"
                                               TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,8,*">
                                        <Button x:Name="ApplyUsbCaptureSettingsButton"
                                                Grid.Column="0"
                                                Classes="primary"
                                                Content="Apply" />
                                        <Button x:Name="RevertUsbCaptureSettingsButton"
                                                Grid.Column="2"
                                                Classes="ghost"
                                                Content="Revert" />
                                    </Grid>
                                </StackPanel>
                                  <ComboBox x:Name="CameraZoneComboBox" />
                                <Button x:Name="ToggleGridEditorButton"
                                        Classes="ghost"
                                        Content="Open Grid Region Editor" />

                                <StackPanel x:Name="GridEditorPanel"
                                            Spacing="6"
                                            IsVisible="False">
                                    <TextBlock Text="Grid Region Editor"
                                               Classes="sectionTitle"
                                               Margin="0,8,0,0" />
                                    <ComboBox x:Name="LayerTypeComboBox" />
                                    <Grid ColumnDefinitions="*,8,*">
                                        <Button x:Name="AddLayerButton"
                                                Grid.Column="0"
                                                Classes="ghost"
                                                Content="Add Layer" />
                                        <Button x:Name="DeleteLayerButton"
                                                Grid.Column="2"
                                                Classes="ghost"
                                                Content="Delete Layer" />
                                    </Grid>
                                    <ListBox x:Name="LayersListBox"
                                             MinHeight="70"
                                             MaxHeight="120" />
                                    <ListBox x:Name="RegionsListBox"
                                             MinHeight="70"
                                             MaxHeight="120" />
                                    <TextBox x:Name="RegionNameTextBox"
                                             Watermark="Region name" />
                                    <TextBox x:Name="RegionCodeTextBox"
                                             Watermark="Region code (optional)" />
                                    <TextBox x:Name="RegionCellsTextBox"
                                             Watermark="Cells: 1,1;2,1" />
                                    <Grid ColumnDefinitions="*,8,*">
                                        <Button x:Name="SaveRegionButton"
                                                Grid.Column="0"
                                                Classes="primary"
                                                Content="Save Region" />
                                        <Button x:Name="DeleteRegionButton"
                                                Grid.Column="2"
                                                Classes="ghost"
                                                Content="Delete Region" />
                                    </Grid>
                                    <Button x:Name="RefreshCompositionPreviewButton"
                                            Classes="ghost"
                                            Content="Refresh Composition Preview" />
                                    <ListBox x:Name="CompositionPreviewListBox"
                                             MinHeight="80"
                                             MaxHeight="140" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="6"
                                Classes="surfaceAlt"
                                Padding="10">
                            <Grid RowDefinitions="Auto,6,*,8,Auto">
                                <StackPanel Grid.Row="0"
                                            Spacing="2">
                                    <TextBlock Text="Processing"
                                               Classes="sectionTitle" />
                                    <TextBlock Text="Compact runtime tuning for selected camera"
                                               Classes="muted"
                                               TextWrapping="Wrap" />
                                    <DockPanel LastChildFill="False"
                                               Margin="0,2,0,0">
                                        <Border Background="#26323B"
                                                BorderBrush="#3C4F5E"
                                                BorderThickness="1"
                                                Padding="4,1"
                                                Margin="0,0,6,0">
                                            <TextBlock Text="i"
                                                       Foreground="#CFE0EC"
                                                       FontSize="11"
                                                       FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Text="Hover labels for parameter help"
                                                   Classes="muted"
                                                   FontSize="11"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>

                                <ScrollViewer Grid.Row="2"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <CheckBox x:Name="LoopVideoCheckBox"
                                                      Content="Loop this video source"
                                                      IsChecked="True" />
                                            <Border Background="#26323B"
                                                    BorderBrush="#3C4F5E"
                                                    BorderThickness="1"
                                                    Padding="4,1"
                                                    ToolTip.Tip="When enabled, the selected video source restarts automatically after reaching the end."
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="i"
                                                           Foreground="#CFE0EC"
                                                           FontSize="11"
                                                           FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>

                                        <Grid ColumnDefinitions="*,8,*"
                                              RowDefinitions="Auto,8,Auto,8,Auto,8,Auto">
                                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="Samples"
                                                               Classes="eyebrow" />
                                                    <Border Background="#26323B"
                                                            BorderBrush="#3C4F5E"
                                                            BorderThickness="1"
                                                            Padding="4,1"
                                                            ToolTip.Tip="Number of frames used to estimate the static background model. Higher values improve stability but increase startup time."
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="i"
                                                                   Foreground="#CFE0EC"
                                                                   FontSize="11"
                                                                   FontWeight="Bold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBox x:Name="SampleCountTextBox"
                                                         Text="20"
                                                         Watermark="20" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="Bake Source"
                                                               Classes="eyebrow" />
                                                    <Border Background="#26323B"
                                                            BorderBrush="#3C4F5E"
                                                            BorderThickness="1"
                                                            Padding="4,1"
                                                            ToolTip.Tip="Choose whether the background model is baked from sampled source frames or from a single image file."
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="i"
                                                                   Foreground="#CFE0EC"
                                                                   FontSize="11"
                                                                   FontWeight="Bold" />
                                                    </Border>
                                                </StackPanel>
                                                <ComboBox x:Name="BakeSourceComboBox"
                                                          ToolTip.Tip="Source used to create the baked background mask for subtraction."
                                                          SelectedIndex="0">
                                                    <ComboBoxItem Content="Samples from source" />
                                                    <ComboBoxItem Content="Image file" />
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="Bake Image"
                                                               Classes="eyebrow" />
                                                    <Border Background="#26323B"
                                                            BorderBrush="#3C4F5E"
                                                            BorderThickness="1"
                                                            Padding="4,1"
                                                            ToolTip.Tip="Path to an image used as the background reference when Bake Source is set to Image file."
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="i"
                                                                   Foreground="#CFE0EC"
                                                                   FontSize="11"
                                                                   FontWeight="Bold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBox x:Name="BakeImagePathTextBox"
                                                         IsReadOnly="True"
                                                         Watermark="No image selected" />
                                                <Grid ColumnDefinitions="*,8,*">
                                                    <Button x:Name="SelectBakeImageButton"
                                                            Grid.Column="0"
                                                            Classes="ghost"
                                                            ToolTip.Tip="Pick an image file to use as the baked background reference."
                                                            Content="Select Image" />
                                                    <Button x:Name="ClearBakeImageButton"
                                                            Grid.Column="2"
                                                            Classes="ghost"
                                                            ToolTip.Tip="Remove the currently selected baked image path."
                                                            Content="Clear Image" />
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Row="4" Grid.Column="0" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="Threshold"
                                                               Classes="eyebrow" />
                                                    <Border Background="#26323B"
                                                            BorderBrush="#3C4F5E"
                                                            BorderThickness="1"
                                                            Padding="4,1"
                                                            ToolTip.Tip="Pixel-difference threshold for foreground detection. Lower values detect subtle motion; higher values ignore small changes/noise."
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="i"
                                                                   Foreground="#CFE0EC"
                                                                   FontSize="11"
                                                                   FontWeight="Bold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBox x:Name="ThresholdTextBox"
                                                         Text="100"
                                                         Watermark="100" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="4" Grid.Column="2" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="Motion Area"
                                                               Classes="eyebrow" />
                                                    <Border Background="#26323B"
                                                            BorderBrush="#3C4F5E"
                                                            BorderThickness="1"
                                                            Padding="4,1"
                                                            ToolTip.Tip="Minimum contour/pixel area treated as valid motion. Increase to suppress tiny flicker and noise blobs."
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="i"
                                                                   Foreground="#CFE0EC"
                                                                   FontSize="11"
                                                                   FontWeight="Bold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBox x:Name="MotionAreaTextBox"
                                                         Text="220"
                                                         Watermark="220" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="6" Grid.Column="0" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="Color Pixels"
                                                               Classes="eyebrow" />
                                                    <Border Background="#26323B"
                                                            BorderBrush="#3C4F5E"
                                                            BorderThickness="1"
                                                            Padding="4,1"
                                                            ToolTip.Tip="Minimum number of matched color pixels required before color-based detection is considered active."
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="i"
                                                                   Foreground="#CFE0EC"
                                                                   FontSize="11"
                                                                   FontWeight="Bold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBox x:Name="ColorMinPixelsTextBox"
                                                         Text="40"
                                                         Watermark="40" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="6" Grid.Column="2" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="Morph Kernel"
                                                               Classes="eyebrow" />
                                                    <Border Background="#26323B"
                                                            BorderBrush="#3C4F5E"
                                                            BorderThickness="1"
                                                            Padding="4,1"
                                                            ToolTip.Tip="Kernel size for morphology (erode/dilate) cleanup. Larger kernels remove more speckle but can merge nearby regions."
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="i"
                                                                   Foreground="#CFE0EC"
                                                                   FontSize="11"
                                                                   FontWeight="Bold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBox x:Name="MorphKernelSizeTextBox"
                                                         Text="3"
                                                         Watermark="3" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Process Width"
                                                           Classes="eyebrow" />
                                                <Border Background="#26323B"
                                                        BorderBrush="#3C4F5E"
                                                        BorderThickness="1"
                                                        Padding="4,1"
                                                        ToolTip.Tip="Target frame width used for processing. Lower widths run faster; higher widths preserve detail at higher CPU cost."
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="i"
                                                               Foreground="#CFE0EC"
                                                               FontSize="11"
                                                               FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBox x:Name="ProcessWidthTextBox"
                                                     Text="640"
                                                     Watermark="640" />
                                        </StackPanel>

                                        <Border Classes="surfaceAlt"
                                                Padding="8">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Color Calibration"
                                                           Classes="sectionTitle" />

                                                <Grid ColumnDefinitions="*,8,*"
                                                      RowDefinitions="Auto,8,Auto,8,Auto,8,Auto">
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Spacing="4">
                                                        <TextBlock Text="Color"
                                                                   Classes="eyebrow" />
                                                        <ComboBox x:Name="CalibrationColorComboBox"
                                                                  SelectedIndex="0">
                                                            <ComboBoxItem Content="red" />
                                                            <ComboBoxItem Content="green" />
                                                            <ComboBoxItem Content="blue" />
                                                            <ComboBoxItem Content="yellow" />
                                                            <ComboBoxItem Content="white" />
                                                            <ComboBoxItem Content="black" />
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                                        <TextBlock Text="Hue Min"
                                                                   Classes="eyebrow" />
                                                        <TextBox x:Name="HueLowerTextBox"
                                                                 Text="0"
                                                                 Watermark="0" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4">
                                                        <TextBlock Text="Hue Max"
                                                                   Classes="eyebrow" />
                                                        <TextBox x:Name="HueUpperTextBox"
                                                                 Text="180"
                                                                 Watermark="180" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="4" Grid.Column="0" Spacing="4">
                                                        <TextBlock Text="Sat Min"
                                                                   Classes="eyebrow" />
                                                        <TextBox x:Name="SaturationLowerTextBox"
                                                                 Text="0"
                                                                 Watermark="0" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="4" Grid.Column="2" Spacing="4">
                                                        <TextBlock Text="Sat Max"
                                                                   Classes="eyebrow" />
                                                        <TextBox x:Name="SaturationUpperTextBox"
                                                                 Text="255"
                                                                 Watermark="255" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="6" Grid.Column="0" Spacing="4">
                                                        <TextBlock Text="Val Min"
                                                                   Classes="eyebrow" />
                                                        <TextBox x:Name="ValueLowerTextBox"
                                                                 Text="0"
                                                                 Watermark="0" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="6" Grid.Column="2" Spacing="4">
                                                        <TextBlock Text="Val Max"
                                                                   Classes="eyebrow" />
                                                        <TextBox x:Name="ValueUpperTextBox"
                                                                 Text="255"
                                                                 Watermark="255" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <Grid Grid.Row="4"
                                      ColumnDefinitions="*,8,*">
                                    <Button x:Name="StartStopButton"
                                            Grid.Column="0"
                                            Classes="primary"
                                            Content="Start"
                                            FontWeight="Bold" />
                                    <Button x:Name="OpenBakedMaskButton"
                                            Grid.Column="2"
                                            Classes="ghost"
                                            Content="Open Baked Mask" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    </Grid>
                    </ScrollViewer>
                </Grid>
                    </Border>
                </SplitView.Pane>

                <Border Classes="surface"
                        Padding="10">
                <Grid RowDefinitions="Auto,8,Auto,8,*">
                    <Border Grid.Row="0"
                            Classes="surfaceAlt"
                            Padding="8">
                        <Grid ColumnDefinitions="*,8,*,Auto">
                            <TextBlock x:Name="CurrentVideoText"
                                       Grid.Column="0"
                                       Text="Current camera/source: -"
                                       VerticalAlignment="Center"
                                       Foreground="#E8F0F5"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />

                            <TextBlock x:Name="StatusText"
                                       Grid.Column="2"
                                       Text="Status: ready"
                                       Classes="muted"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />

                            <Grid Grid.Column="3"
                                  ColumnDefinitions="Auto,6,Auto,6,Auto">
                                <Button Grid.Column="0"
                                        x:Name="PreviousVideoButton"
                                        Classes="ghost"
                                        Content="Previous" />
                                <Button Grid.Column="2"
                                        x:Name="NextVideoButton"
                                        Classes="ghost"
                                        Content="Next" />
                                <Button Grid.Column="4"
                                        x:Name="MarkAmbiguityButton"
                                        Classes="destructive"
                                        Content="Mark Ambiguity" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            x:Name="AmbiguityBanner"
                            Background="#4A1E25"
                            BorderBrush="#D17A86"
                            BorderThickness="1"
                            Padding="8"
                            IsVisible="False">
                        <Grid ColumnDefinitions="*,8,Auto,6,Auto,6,Auto,6,Auto">
                            <TextBlock x:Name="AmbiguityText"
                                       Grid.Column="0"
                                       Text="Ambiguity detected. Resolve before automatic processing continues."
                                       Foreground="#FFEDEE"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button x:Name="ResolveRemovedButton"
                                    Grid.Column="2"
                                    Classes="ghost"
                                    Content="Removed" />
                            <Button x:Name="ResolveRelinkButton"
                                    Grid.Column="4"
                                    Classes="ghost"
                                    Content="Relinked" />
                            <Button x:Name="ResolveFalseButton"
                                    Grid.Column="6"
                                    Classes="ghost"
                                    Content="False" />
                            <Button x:Name="ResolveOtherButton"
                                    Grid.Column="8"
                                    Classes="ghost"
                                    Content="Other" />
                        </Grid>
                    </Border>

                    <UniformGrid x:Name="CameraTileGrid"
                                 Grid.Row="4"
                                 Rows="2"
                                 Columns="2" />
                </Grid>
                </Border>
            </SplitView>

            <Expander x:Name="RuntimeLogExpander"
                       Grid.Row="1"
                       IsExpanded="False"
                      Header="Runtime Log"
                      Margin="0,8,0,0"
                      FontWeight="SemiBold">
                <ListBox x:Name="LogListBox"
                         Height="170"
                         FontFamily="Cascadia Mono"
                         FontSize="12" />
            </Expander>
        </Grid>

        <Border x:Name="LayersWorkspacePanel"
                Grid.Row="1"
                Classes="surface"
                IsVisible="False"
                Padding="16">
            <Grid ColumnDefinitions="360,16,*"
                  RowDefinitions="Auto,8,*">
                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Spacing="4">
                    <TextBlock Text="Layers Workspace"
                               Classes="sectionTitle" />
                    <TextBlock Text="Global Layer Type management and read-only camera usage."
                               Classes="muted" />
                </StackPanel>

                <Border Grid.Row="2"
                        Grid.Column="0"
                        Classes="surfaceAlt"
                        Padding="10">
                    <Grid RowDefinitions="Auto,8,*,8,Auto">
                        <TextBlock Grid.Row="0"
                                   Text="Layer Types"
                                   Classes="sectionTitle" />
                        <ListBox Grid.Row="2"
                                 x:Name="GlobalLayerTypesListBox"
                                 SelectionMode="Single" />
                        <Button Grid.Row="4"
                                x:Name="DeleteGlobalLayerTypeButton"
                                Classes="destructive"
                                Content="Delete Layer Type" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2"
                      Grid.Column="2"
                      RowDefinitions="Auto,8,Auto,8,*">
                    <Border Grid.Row="0"
                            Classes="surfaceAlt"
                            Padding="10">
                        <Grid RowDefinitions="Auto,8,Auto,8,Auto"
                              ColumnDefinitions="*,8,*,8,*">
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="5"
                                       Text="Global Layer Type"
                                       Classes="sectionTitle" />
                            <TextBox Grid.Row="2"
                                     Grid.Column="0"
                                     x:Name="GlobalLayerTypeIdTextBox"
                                     Watermark="Layer Type ID" />
                            <TextBox Grid.Row="2"
                                     Grid.Column="2"
                                     x:Name="GlobalLayerTypeNameTextBox"
                                     Watermark="Display name" />
                            <TextBox Grid.Row="2"
                                     Grid.Column="4"
                                     x:Name="GlobalLayerTypePrecedenceTextBox"
                                     Watermark="Precedence" />
                            <Button Grid.Row="4"
                                    Grid.Column="0"
                                    x:Name="AddGlobalLayerTypeButton"
                                    Classes="primary"
                                    Content="Add Layer Type" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2"
                               x:Name="GlobalLayerTypeDeleteStatusText"
                               Classes="muted"
                               Text="Select a Layer Type to inspect usage." />

                    <Border Grid.Row="4"
                            Classes="surfaceAlt"
                            Padding="10">
                        <Grid RowDefinitions="Auto,8,*">
                            <TextBlock Grid.Row="0"
                                       Text="Camera Usage"
                                       Classes="sectionTitle" />
                            <ListBox Grid.Row="2"
                                     x:Name="GlobalLayerTypeUsageListBox" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="SettingsWorkspacePanel"
                Grid.Row="1"
                Classes="surface"
                IsVisible="False"
                Padding="16">
            <Grid RowDefinitions="Auto,12,Auto,12,Auto,12,*"
                  ColumnDefinitions="360,16,*">
                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Spacing="4">
                    <TextBlock Text="Settings Workspace"
                               Classes="sectionTitle" />
                    <TextBlock Text="Global settings use draft edits until explicitly saved."
                               Classes="muted" />
                </StackPanel>

                <Border Grid.Row="2"
                        Grid.Column="0"
                        Classes="surfaceAlt"
                        Padding="10">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Grid Settings"
                                   Classes="sectionTitle" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Grid Columns"
                                       Classes="eyebrow" />
                            <TextBlock x:Name="SettingsGridColumnsPolicyText"
                                       Classes="muted" />
                        </StackPanel>
                        <TextBox x:Name="SettingsGridColumnsTextBox"
                                 Watermark="32" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Grid Rows"
                                       Classes="eyebrow" />
                            <TextBlock x:Name="SettingsGridRowsPolicyText"
                                       Classes="muted" />
                        </StackPanel>
                        <TextBox x:Name="SettingsGridRowsTextBox"
                                  Watermark="18" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Missing Frame Behavior"
                                       Classes="eyebrow" />
                            <TextBlock x:Name="SettingsMissingFrameBehaviorPolicyText"
                                       Classes="muted" />
                        </StackPanel>
                        <ComboBox x:Name="SettingsMissingFrameBehaviorComboBox" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Grid.Column="2"
                        Classes="surfaceAlt"
                        Padding="10">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Draft State"
                                   Classes="sectionTitle" />
                        <TextBlock x:Name="SettingsDraftStatusText"
                                   Text="Settings: saved"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="SettingsPendingRestartText"
                                   Text="Pending restart: none"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Leaving Settings with unsaved changes asks Save / Discard / Cancel."
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="4"
                      Grid.Column="0"
                      ColumnDefinitions="*,8,*">
                    <Button Grid.Column="0"
                            x:Name="SaveSettingsButton"
                            Classes="primary"
                            Content="Save Settings" />
                    <Button Grid.Column="2"
                            x:Name="DiscardSettingsButton"
                            Classes="ghost"
                            Content="Discard Changes" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Classes="surfaceAlt"
                Margin="0,8,0,0"
                Padding="8">
            <Grid ColumnDefinitions="*,16,*,16,*,16,*">
                <TextBlock x:Name="BottomVisionPipelineStateText"
                           Grid.Column="0"
                           Text="Vision Pipeline: stopped"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="BottomAmbiguityStateText"
                           Grid.Column="2"
                           Text="Ambiguity Alert: clear" />
                <TextBlock x:Name="BottomCalibrationStateText"
                           Grid.Column="4"
                           Text="Calibration: unknown" />
                <TextBlock x:Name="BottomPendingRestartStateText"
                           Grid.Column="6"
                           Text="Pending restart: none" />
            </Grid>
        </Border>

    </Grid>
</wnd:AppWindow>
