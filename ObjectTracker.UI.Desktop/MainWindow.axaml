<wnd:AppWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:wnd="using:FluentAvalonia.UI.Windowing"
               mc:Ignorable="d"
               x:Class="ObjectTracker.UI.Desktop.MainWindow"
               Title="ObjectTracker"
               Width="1920"
               Height="1080"
               MinWidth="1080"
               MinHeight="680"
               Background="{StaticResource AppBackgroundBrush}"
               d:DesignWidth="1920"
               d:DesignHeight="1080">
    <Grid RowDefinitions="40,*,Auto"
          Margin="10,0,10,10">

        <!-- Compact title bar / branding strip -->
        <Border Grid.Row="0"
                Background="Transparent"
                wnd:AppWindow.AllowInteractionInTitleBar="True">
            <Menu DockPanel.Dock="Right"
                  Margin="0,0,12,0"
                  VerticalAlignment="Center"
                  Background="Transparent">
                <MenuItem Header="Camera"
                          x:Name="CameraWorkspaceMenuItem">
                    <MenuItem Header="Open Workspace"
                              x:Name="OpenCameraWorkspaceMenuItem" />
                    <MenuItem Header="Clear Cameras"
                              x:Name="ClearCamerasMenuItem" />
                </MenuItem>
                <MenuItem Header="Regions"
                          x:Name="RegionsWorkspaceMenuItem">
                    <MenuItem Header="Export Regions"
                              x:Name="ExportRegionMenuButton" />
                    <MenuItem Header="Import Regions"
                              x:Name="ImportRegionMenuButton" />
                </MenuItem>
                <MenuItem Header="Trains"
                          x:Name="TrainsWorkspaceMenuItem" />
                <MenuItem Header="Settings"
                          x:Name="SettingsWorkspaceMenuItem" />
                <MenuItem Header="PLC"
                          x:Name="PlcWorkspaceMenuItem" />
                <MenuItem Header="Vision Pipeline"
                          x:Name="VisionPipelineMenuItem">
                    <MenuItem Header="Start"
                              x:Name="StartVisionPipelineMenuItem" />
                    <MenuItem Header="Stop"
                              x:Name="StopVisionPipelineMenuItem" />
                </MenuItem>
            </Menu>
        </Border>

        <Grid x:Name="CameraWorkspacePanel"
              Grid.Row="1"
              RowDefinitions="*,Auto">
            <SplitView x:Name="CameraSplitView"
                       Grid.Row="0"
                       OpenPaneLength="340"
                       CompactPaneLength="0"
                       DisplayMode="Inline"
                       IsPaneOpen="True"
                       UseLightDismissOverlayMode="True">
                <SplitView.Pane>
                    <Border x:Name="CameraPanelBorder"
                            Classes="surface"
                            Padding="10">
                        <Grid RowDefinitions="Auto,8,*">
                            <Grid Grid.Row="0" ColumnDefinitions="*,8,Auto,8,Auto">
                                <TextBlock x:Name="CameraPanelTitleText"
                                           Grid.Column="0"
                                           Text="Camera Sources"
                                           Classes="sectionTitle" />
                                <Button x:Name="ToggleCameraPanelButton"
                                        Grid.Column="2"
                                        Classes="ghost"
                                        Content="Hide" />
                                <Button x:Name="PinCameraPanelButton"
                                        Grid.Column="4"
                                        Classes="ghost"
                                        Content="📌" />
                            </Grid>

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <Grid x:Name="CameraPanelFullContent"
                                      RowDefinitions="Auto,8,*">
                                    <ListBox Grid.Row="0"
                                             x:Name="PlaylistListBox"
                                             SelectionMode="Single"
                                             MinHeight="150"
                                             MaxHeight="220">
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem x:Name="DeleteSelectedCameraMenuItem"
                                                          Header="Delete Camera" />
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                    </ListBox>

                                    <Grid Grid.Row="2"
                                          RowDefinitions="Auto,8,Auto,8,Auto,8,*">
                                        <Grid Grid.Row="0"
                                              ColumnDefinitions="*,6,*">
                                            <Button x:Name="AddVideosButton"
                                                    Grid.Column="0"
                                                    Classes="primary"
                                                    Content="Add Camera" />
                                            <Button x:Name="RemoveSelectedButton"
                                                    Grid.Column="2"
                                                    Classes="destructive"
                                                    Content="Remove" />
                                        </Grid>

                                        <Grid Grid.Row="2"
                                              ColumnDefinitions="*,6,*">
                                            <Button x:Name="MoveCameraUpButton"
                                                    Grid.Column="0"
                                                    Classes="ghost"
                                                    Content="Move Up" />
                                            <Button x:Name="MoveCameraDownButton"
                                                    Grid.Column="2"
                                                    Classes="ghost"
                                                    Content="Move Down" />
                                        </Grid>

                                        <Border Grid.Row="4"
                                                Classes="surfaceAlt"
                                                Padding="10">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Camera Zone"
                                                           Classes="sectionTitle" />
                                                <TextBlock Text="Bind selected source to a stable Camera Zone"
                                                           Classes="muted"
                                                           TextWrapping="Wrap" />
                                                <CheckBox x:Name="CameraVisibilityCheckBox"
                                                          Content="Camera Visibility"
                                                          IsChecked="True" />
                                                <CheckBox x:Name="VisionPipelineInclusionCheckBox"
                                                          Content="Vision Pipeline Inclusion"
                                                          IsChecked="True" />
                                                 <CheckBox x:Name="CameraDebugViewCheckBox"
                                                            Content="Debug View"
                                                            IsChecked="False" />
                                                  <ComboBox x:Name="DebugViewFrameTypeComboBox"
                                                             SelectedIndex="0">
                                                      <ComboBoxItem Content="Moving Color" />
                                                      <ComboBoxItem Content="Color Detections" />
                                                    </ComboBox>
                                               <CheckBox x:Name="ShowAnnotationsCheckBox"
                                                            Content="Show Annotations"
                                                            IsChecked="False" />
                                               <CheckBox x:Name="ShowRegionsCheckBox"
                                                            Content="Show Regions"
                                                            IsChecked="False" />
                                          </StackPanel>
                                        </Border>

                                        <Border Grid.Row="6"
                                                Classes="surfaceAlt"
                                                Padding="10">
                                            <Grid RowDefinitions="Auto,6,*,8,Auto">
                                                <StackPanel Grid.Row="0"
                                                            Spacing="2">
                                                    <TextBlock Text="Processing"
                                                               Classes="sectionTitle" />
                                                    <TextBlock Text="Compact runtime tuning for selected camera"
                                                               Classes="muted"
                                                               TextWrapping="Wrap" />
                                                    <DockPanel LastChildFill="False"
                                                               Margin="0,2,0,0">
                                                        <Border Background="#26323B"
                                                                BorderBrush="#3C4F5E"
                                                                BorderThickness="1"
                                                                Padding="4,1"
                                                                Margin="0,0,6,0">
                                                            <TextBlock Text="i"
                                                                       Foreground="#CFE0EC"
                                                                       FontSize="11"
                                                                       FontWeight="Bold" />
                                                        </Border>
                                                        <TextBlock Text="Hover labels for parameter help"
                                                                   Classes="muted"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </StackPanel>

                                                <ScrollViewer Grid.Row="2"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <StackPanel Spacing="8">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <CheckBox x:Name="LoopPlaylistCheckBox"
                                                                      Content="Loop camera videos"
                                                                      IsChecked="True" />
                                                            <Border Background="#26323B"
                                                                    BorderBrush="#3C4F5E"
                                                                    BorderThickness="1"
                                                                    Padding="4,1"
                                                                    ToolTip.Tip="When enabled, the selected video source restarts automatically after reaching the end."
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="i"
                                                                           Foreground="#CFE0EC"
                                                                           FontSize="11"
                                                                           FontWeight="Bold" />
                                                            </Border>
                                                        </StackPanel>

                                                        <Grid ColumnDefinitions="*,8,*"
                                                              RowDefinitions="Auto,8,Auto,8,Auto,8,Auto">
                                                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="Samples"
                                                                               Classes="eyebrow" />
                                                                    <Border Background="#26323B"
                                                                            BorderBrush="#3C4F5E"
                                                                            BorderThickness="1"
                                                                            Padding="4,1"
                                                                            ToolTip.Tip="Number of frames used to estimate the static background model. Higher values improve stability but increase startup time."
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="i"
                                                                                   Foreground="#CFE0EC"
                                                                                   FontSize="11"
                                                                                   FontWeight="Bold" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBox x:Name="SampleCountTextBox"
                                                                         Text="20"
                                                                         Watermark="20" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="Bake Source"
                                                                               Classes="eyebrow" />
                                                                    <Border Background="#26323B"
                                                                            BorderBrush="#3C4F5E"
                                                                            BorderThickness="1"
                                                                            Padding="4,1"
                                                                            ToolTip.Tip="Choose whether the background model is baked from sampled source frames or from a single image file."
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="i"
                                                                                   Foreground="#CFE0EC"
                                                                                   FontSize="11"
                                                                                   FontWeight="Bold" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <ComboBox x:Name="BakeSourceComboBox"
                                                                          ToolTip.Tip="Source used to create the baked background mask for subtraction."
                                                                          SelectedIndex="0">
                                                                    <ComboBoxItem Content="Samples from source" />
                                                                    <ComboBoxItem Content="Image file" />
                                                                </ComboBox>
                                                            </StackPanel>

                                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Spacing="4">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="Bake Image"
                                                                               Classes="eyebrow" />
                                                                    <Border Background="#26323B"
                                                                            BorderBrush="#3C4F5E"
                                                                            BorderThickness="1"
                                                                            Padding="4,1"
                                                                            ToolTip.Tip="Path to an image used as the background reference when Bake Source is set to Image file."
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="i"
                                                                                   Foreground="#CFE0EC"
                                                                                   FontSize="11"
                                                                                   FontWeight="Bold" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBox x:Name="BakeImagePathTextBox"
                                                                         IsReadOnly="True"
                                                                         Watermark="No image selected" />
                                                                <Grid ColumnDefinitions="*,8,*">
                                                                    <Button x:Name="SelectBakeImageButton"
                                                                            Grid.Column="0"
                                                                            Classes="ghost"
                                                                            ToolTip.Tip="Pick an image file to use as the baked background reference."
                                                                            Content="Select Image" />
                                                                    <Button x:Name="ClearBakeImageButton"
                                                                            Grid.Column="2"
                                                                            Classes="ghost"
                                                                            ToolTip.Tip="Remove the currently selected baked image path."
                                                                            Content="Clear Image" />
                                                                </Grid>
                                                            </StackPanel>

                                                            <StackPanel Grid.Row="4" Grid.Column="0" Spacing="4">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="Threshold"
                                                                               Classes="eyebrow" />
                                                                    <Border Background="#26323B"
                                                                            BorderBrush="#3C4F5E"
                                                                            BorderThickness="1"
                                                                            Padding="4,1"
                                                                            ToolTip.Tip="Pixel-difference threshold for foreground detection. Lower values detect subtle motion; higher values ignore small changes/noise."
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="i"
                                                                                   Foreground="#CFE0EC"
                                                                                   FontSize="11"
                                                                                   FontWeight="Bold" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBox x:Name="ThresholdTextBox"
                                                                         Text="100"
                                                                         Watermark="100" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Row="4" Grid.Column="2" Spacing="4">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="Motion Area"
                                                                               Classes="eyebrow" />
                                                                    <Border Background="#26323B"
                                                                            BorderBrush="#3C4F5E"
                                                                            BorderThickness="1"
                                                                            Padding="4,1"
                                                                            ToolTip.Tip="Minimum contour/pixel area treated as valid motion. Increase to suppress tiny flicker and noise blobs."
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="i"
                                                                                   Foreground="#CFE0EC"
                                                                                   FontSize="11"
                                                                                   FontWeight="Bold" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBox x:Name="MotionAreaTextBox"
                                                                         Text="220"
                                                                         Watermark="220" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Row="6" Grid.Column="0" Spacing="4">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="Color Pixels"
                                                                               Classes="eyebrow" />
                                                                    <Border Background="#26323B"
                                                                            BorderBrush="#3C4F5E"
                                                                            BorderThickness="1"
                                                                            Padding="4,1"
                                                                            ToolTip.Tip="Minimum number of matched color pixels required before color-based detection is considered active."
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="i"
                                                                                   Foreground="#CFE0EC"
                                                                                   FontSize="11"
                                                                                   FontWeight="Bold" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBox x:Name="ColorMinPixelsTextBox"
                                                                         Text="40"
                                                                         Watermark="40" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Row="6" Grid.Column="2" Spacing="4">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="Morph Kernel"
                                                                               Classes="eyebrow" />
                                                                    <Border Background="#26323B"
                                                                            BorderBrush="#3C4F5E"
                                                                            BorderThickness="1"
                                                                            Padding="4,1"
                                                                            ToolTip.Tip="Kernel size for morphology (erode/dilate) cleanup. Larger kernels remove more speckle but can merge nearby regions."
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="i"
                                                                                   Foreground="#CFE0EC"
                                                                                   FontSize="11"
                                                                                   FontWeight="Bold" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBox x:Name="MorphKernelSizeTextBox"
                                                                         Text="3"
                                                                         Watermark="3" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <StackPanel Spacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="Process Width"
                                                                           Classes="eyebrow" />
                                                                <Border Background="#26323B"
                                                                        BorderBrush="#3C4F5E"
                                                                        BorderThickness="1"
                                                                        Padding="4,1"
                                                                        ToolTip.Tip="Target frame width used for processing. Lower widths run faster; higher widths preserve detail at higher CPU cost."
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="i"
                                                                               Foreground="#CFE0EC"
                                                                               FontSize="11"
                                                                               FontWeight="Bold" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBox x:Name="ProcessWidthTextBox"
                                                                     Text="640"
                                                                     Watermark="640" />
                                                        </StackPanel>

                                                    </StackPanel>
                                                </ScrollViewer>

                                                <Grid Grid.Row="4"
                                                      ColumnDefinitions="*,8,*">
                                                    <Button x:Name="StartStopButton"
                                                            Grid.Column="0"
                                                            Classes="primary"
                                                            Content="Start"
                                                            FontWeight="Bold" />
                                                    <Button x:Name="OpenBakedMaskButton"
                                                            Grid.Column="2"
                                                            Classes="ghost"
                                                            Content="Open Baked Mask" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </SplitView.Pane>

                <Border Classes="surface"
                        Padding="10">
                    <Grid RowDefinitions="Auto,8,Auto,8,*">
                        <Border Grid.Row="0"
                                Classes="surfaceAlt"
                                Padding="8">
                            <Grid ColumnDefinitions="*,8,*,Auto">
                                <TextBlock x:Name="CurrentVideoText"
                                           Grid.Column="0"
                                           Text="Current camera/source: -"
                                           VerticalAlignment="Center"
                                           Foreground="#E8F0F5"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />

                                <TextBlock x:Name="StatusText"
                                           Grid.Column="2"
                                           Text="Status: ready"
                                           Classes="muted"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />

                                <Grid Grid.Column="3"
                                      ColumnDefinitions="Auto,6,Auto,6,Auto">
                                    <Button Grid.Column="0"
                                            x:Name="PreviousVideoButton"
                                            Classes="ghost"
                                            Content="Previous" />
                                    <Button Grid.Column="2"
                                            x:Name="NextVideoButton"
                                            Classes="ghost"
                                            Content="Next" />
                                </Grid>
                            </Grid>
                        </Border>

                        <UniformGrid x:Name="CameraTileGrid"
                                     Grid.Row="4"
                                     Rows="2"
                                     Columns="2" />
                    </Grid>
                </Border>
            </SplitView>

            <Expander x:Name="RuntimeLogExpander"
                      Grid.Row="1"
                      IsExpanded="False"
                      Header="Runtime Log"
                      Margin="0,8,0,0"
                      FontWeight="SemiBold">
                <ListBox x:Name="LogListBox"
                         Height="170"
                         FontFamily="Cascadia Mono"
                         FontSize="12" />
            </Expander>
        </Grid>

        <Border x:Name="RegionsWorkspacePanel"
                Grid.Row="1"
                Classes="surface"
                IsVisible="False"
                Padding="16">
            <Grid ColumnDefinitions="360,16,*"
                  RowDefinitions="Auto,8,*">
                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Spacing="4">
                    <TextBlock Text="Regions Workspace"
                               Classes="sectionTitle" />
                    <TextBlock Text="Manage camera zone regions for train detection behavior."
                               Classes="muted" />
                </StackPanel>

                <Border Grid.Row="2"
                        Grid.Column="0"
                        Classes="surfaceAlt"
                        Padding="10">
                    <Grid RowDefinitions="Auto,8,*">
                        <TextBlock Grid.Row="0"
                                   Text="Camera Zone Regions"
                                   Classes="sectionTitle" />
                        <ListBox Grid.Row="2"
                                 x:Name="RegionsListBox"
                                 SelectionMode="Single" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2"
                      Grid.Column="2"
                      RowDefinitions="Auto,8,Auto,8,*">
                    <Border Grid.Row="0"
                            Classes="surfaceAlt"
                            Padding="10">
                        <Grid RowDefinitions="Auto,8,Auto,8,Auto"
                              ColumnDefinitions="*,8,*,8,*">
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="5"
                                       Text="Create Region"
                                       Classes="sectionTitle" />
                            <TextBox Grid.Row="2"
                                     Grid.Column="0"
                                     x:Name="RegionNameTextBox"
                                     Watermark="Region name" />
                            <ComboBox Grid.Row="2"
                                      Grid.Column="2"
                                      x:Name="RegionTypeComboBox">
                                <ComboBoxItem Content="Exclude Region" Tag="0" />
                                <ComboBoxItem Content="High Probability Rail Region" Tag="10" />
                                <ComboBoxItem Content="Enter Crossroad Region" Tag="20" />
                                <ComboBoxItem Content="Exit Crossroad Region" Tag="30" />
                            </ComboBox>
                            <Button Grid.Row="4"
                                    Grid.Column="0"
                                    x:Name="CreateRegionButton"
                                    Classes="primary"
                                    Content="Create Region" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2"
                                Spacing="8">
                        <Button x:Name="EditRegionButton"
                                Classes="primary"
                                Content="Edit Selected Region" />
                        <Button x:Name="DeleteRegionButton"
                                Classes="destructive"
                                Content="Delete Selected Region" />
                    </StackPanel>

                    <Border Grid.Row="4"
                            Classes="surfaceAlt"
                            Padding="10">
                        <Grid RowDefinitions="Auto,8,*">
                            <TextBlock Grid.Row="0"
                                       Text="Selected Region Details"
                                       Classes="sectionTitle" />
                            <StackPanel Grid.Row="2"
                                        Spacing="4">
                                <TextBlock x:Name="RegionDetailNameText"
                                           Text="No region selected"
                                           Classes="muted" />
                                <TextBlock x:Name="RegionDetailTypeInfoText"
                                           Text=""
                                           Classes="muted" />
                                <TextBlock x:Name="RegionDetailCellCountText"
                                           Text=""
                                           Classes="muted" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="TrainsWorkspacePanel"
                Grid.Row="1"
                Classes="surface"
                IsVisible="False"
                Padding="16">
            <Grid RowDefinitions="Auto,12,*"
                  ColumnDefinitions="360,16,*">
                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Spacing="4">
                    <TextBlock Text="Trains Workspace"
                               Classes="sectionTitle" />
                    <TextBlock Text="Configure Train identity and color calibration here."
                               Classes="muted"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Row="2"
                        Grid.Column="0"
                        Classes="surfaceAlt"
                        Padding="10">
                    <Grid RowDefinitions="Auto,8,* ,8,Auto">
                        <TextBlock Grid.Row="0"
                                   Text="Configured Trains"
                                   Classes="sectionTitle" />
                        <ListBox Grid.Row="2"
                                 x:Name="TrainsListBox"
                                 SelectionMode="Single" />
                        <Grid Grid.Row="4"
                              ColumnDefinitions="*,8,*">
                            <Button x:Name="AddTrainButton"
                                    Grid.Column="0"
                                    Classes="primary"
                                    Content="Add Train" />
                            <Button x:Name="DeleteTrainButton"
                                    Grid.Column="2"
                                    Classes="destructive"
                                    Content="Delete Train" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Grid.Column="2"
                        Classes="surfaceAlt"
                        Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Train Identity"
                                       Classes="sectionTitle" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="Name"
                                           Classes="eyebrow" />
                                <TextBox x:Name="TrainNameTextBox"
                                         Watermark="Red Cargo Train" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="PLC ID"
                                           Classes="eyebrow" />
                                <TextBox x:Name="TrainPlcIdTextBox"
                                         Watermark="PLC free-text ID" />
                            </StackPanel>

                            <TextBlock Text="Calibration Presets"
                                       Classes="sectionTitle" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <Button x:Name="TrainPresetRedButton"
                                        Content="Red" />
                                <Button x:Name="TrainPresetGreenButton"
                                        Content="Green" />
                                <Button x:Name="TrainPresetBlueButton"
                                        Content="Blue" />
                                <Button x:Name="TrainPresetWhiteButton"
                                        Content="White" />
                            </StackPanel>

                            <TextBlock Text="Min/Max Colors"
                                       Classes="sectionTitle" />
                            <Grid ColumnDefinitions="*,8,*">
                                <StackPanel Grid.Column="0"
                                            Spacing="4">
                                    <TextBlock Text="Min Color"
                                               Classes="eyebrow" />
                                    <ColorPicker x:Name="TrainMinColorPicker" />
                                    <TextBox x:Name="TrainMinColorTextBox"
                                             IsReadOnly="True"
                                             Watermark="FF8A0000" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Spacing="4">
                                    <TextBlock Text="Max Color"
                                               Classes="eyebrow" />
                                    <ColorPicker x:Name="TrainMaxColorPicker" />
                                    <TextBox x:Name="TrainMaxColorTextBox"
                                             IsReadOnly="True"
                                             Watermark="FFFF6060" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Max Detection Size"
                                       Classes="sectionTitle" />
                            <Grid ColumnDefinitions="*,8,*">
                                <StackPanel Grid.Column="0"
                                            Spacing="4">
                                    <TextBlock Text="Max Width"
                                               Classes="eyebrow" />
                                    <TextBox x:Name="TrainMaxWidthTextBox"
                                             Watermark="160" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Spacing="4">
                                    <TextBlock Text="Max Height"
                                               Classes="eyebrow" />
                                    <TextBox x:Name="TrainMaxHeightTextBox"
                                             Watermark="80" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Advanced Calibration"
                                       Classes="sectionTitle" />
                            <Grid ColumnDefinitions="*,8,*"
                                  RowDefinitions="Auto,8,Auto,8,Auto">
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Hue Min"
                                               Classes="eyebrow" />
                                    <TextBox x:Name="TrainHueLowerTextBox" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Hue Max"
                                               Classes="eyebrow" />
                                    <TextBox x:Name="TrainHueUpperTextBox" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Sat Min"
                                               Classes="eyebrow" />
                                    <TextBox x:Name="TrainSaturationLowerTextBox" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Sat Max"
                                               Classes="eyebrow" />
                                    <TextBox x:Name="TrainSaturationUpperTextBox" />
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Val Min"
                                               Classes="eyebrow" />
                                    <TextBox x:Name="TrainValueLowerTextBox" />
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Val Max"
                                               Classes="eyebrow" />
                                    <TextBox x:Name="TrainValueUpperTextBox" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,8,*">
                                <Button x:Name="SaveTrainButton"
                                        Grid.Column="0"
                                        Classes="primary"
                                        Content="Save Train" />
                                <TextBlock x:Name="TrainEditorStatusText"
                                           Grid.Column="2"
                                           Classes="muted"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="SettingsWorkspacePanel"
                Grid.Row="1"
                Classes="surface"
                IsVisible="False"
                Padding="16">
            <Grid RowDefinitions="Auto,12,Auto,12,Auto,12,Auto,12,*"
                  ColumnDefinitions="360,16,*">
                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Spacing="4">
                    <TextBlock Text="Settings Workspace"
                               Classes="sectionTitle" />
                    <TextBlock Text="Global settings use draft edits until explicitly saved."
                               Classes="muted" />
                </StackPanel>

                <Border Grid.Row="2"
                        Grid.Column="0"
                        Classes="surfaceAlt"
                        Padding="10">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Grid Settings"
                                   Classes="sectionTitle" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Grid Columns"
                                       Classes="eyebrow" />
                            <TextBlock x:Name="SettingsGridColumnsPolicyText"
                                       Classes="muted" />
                        </StackPanel>
                        <TextBox x:Name="SettingsGridColumnsTextBox"
                                 Watermark="32" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Grid Rows"
                                       Classes="eyebrow" />
                            <TextBlock x:Name="SettingsGridRowsPolicyText"
                                       Classes="muted" />
                        </StackPanel>
                        <TextBox x:Name="SettingsGridRowsTextBox"
                                 Watermark="18" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="4"
                        Grid.Column="0"
                        Classes="surfaceAlt"
                        Padding="10">
                    <StackPanel Spacing="8">
                        <TextBlock Text="PLC Connection"
                                   Classes="sectionTitle" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Base URL"
                                       Classes="eyebrow" />
                            <TextBlock x:Name="SettingsPlcBaseUrlPolicyText"
                                       Classes="muted" />
                        </StackPanel>
                        <TextBox x:Name="SettingsPlcBaseUrlTextBox"
                                 Watermark="https://192.168.0.190" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="User"
                                       Classes="eyebrow" />
                            <TextBlock x:Name="SettingsPlcUserPolicyText"
                                       Classes="muted" />
                        </StackPanel>
                        <TextBox x:Name="SettingsPlcUserTextBox"
                                 Watermark="admin" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Password"
                                       Classes="eyebrow" />
                            <TextBlock x:Name="SettingsPlcPasswordPolicyText"
                                       Classes="muted" />
                        </StackPanel>
                        <TextBox x:Name="SettingsPlcPasswordTextBox"
                                 Watermark="Sander001!" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="6"
                        Grid.Column="2"
                        Classes="surfaceAlt"
                        Padding="10">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Draft State"
                                   Classes="sectionTitle" />
                        <TextBlock x:Name="SettingsDraftStatusText"
                                   Text="Settings: saved"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="SettingsPendingRestartText"
                                   Text="Pending restart: none"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Leaving Settings with unsaved changes asks Save / Discard / Cancel."
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="8"
                      Grid.Column="0"
                      ColumnDefinitions="*,8,*">
                    <Button Grid.Column="0"
                            x:Name="SaveSettingsButton"
                            Classes="primary"
                            Content="Save Settings" />
                    <Button Grid.Column="2"
                            x:Name="DiscardSettingsButton"
                            Classes="ghost"
                            Content="Discard Changes" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="PlcWorkspacePanel"
                Grid.Row="1"
                Classes="surface"
                IsVisible="False"
                Padding="16">
            <Grid RowDefinitions="Auto,12,Auto,12,Auto,12,Auto,12,*"
                  ColumnDefinitions="360,16,*">
                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Spacing="4">
                    <TextBlock Text="PLC Workspace"
                               Classes="sectionTitle" />
                    <TextBlock Text="Test PLC connection and read/write variables."
                               Classes="muted" />
                </StackPanel>

                <Border Grid.Row="2"
                        Grid.Column="0"
                        Classes="surfaceAlt"
                        Padding="10">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Connection"
                                   Classes="sectionTitle" />
                        <Button x:Name="PlcConnectButton"
                                Content="Test Connection"
                                Classes="primary" />
                        <TextBlock x:Name="PlcConnectionStatusText"
                                   Text="Not connected"
                                   Classes="muted" 
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="4"
                        Grid.Column="0"
                        Classes="surfaceAlt"
                        Padding="10">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Read Variable"
                                   Classes="sectionTitle" />
                        <TextBox x:Name="PlcReadVariableTextBox"
                                 Watermark='"Data".random_nr' />
                        <ComboBox x:Name="PlcReadTypeComboBox"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Int16" />
                            <ComboBoxItem Content="Int32" />
                            <ComboBoxItem Content="Real" />
                            <ComboBoxItem Content="Bool" />
                        </ComboBox>
                        <Button x:Name="PlcReadButton"
                                Content="Read"
                                IsEnabled="False" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="6"
                        Grid.Column="0"
                        Classes="surfaceAlt"
                        Padding="10">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Write Variable"
                                   Classes="sectionTitle" />
                        <TextBox x:Name="PlcWriteVariableTextBox"
                                 Watermark='"Data".random_nr' />
                        <TextBox x:Name="PlcWriteValueTextBox"
                                 Watermark="42" />
                        <ComboBox x:Name="PlcWriteTypeComboBox"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Int16" />
                            <ComboBoxItem Content="Int32" />
                            <ComboBoxItem Content="Real" />
                            <ComboBoxItem Content="Bool" />
                        </ComboBox>
                        <Button x:Name="PlcWriteButton"
                                Content="Write"
                                IsEnabled="False" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Grid.Column="2"
                        Classes="surfaceAlt"
                        Padding="10">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Operation Log"
                                   Classes="sectionTitle" />
                        <TextBlock x:Name="PlcOperationLogText"
                                   Text="No operations yet."
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="8"
                      Grid.Column="0"
                      ColumnDefinitions="*,8,*">
                    <Button Grid.Column="0"
                            x:Name="PlcClearLogButton"
                            Content="Clear Log"
                            Classes="ghost" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Classes="surfaceAlt"
                Margin="0,8,0,0"
                Padding="8">
            <Grid ColumnDefinitions="*,16,*,16,*,16,*">
                <TextBlock x:Name="BottomVisionPipelineStateText"
                           Grid.Column="0"
                           Text="Vision Pipeline: stopped"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="BottomCalibrationStateText"
                           Grid.Column="4"
                           Text="Calibration: unknown" />
                <TextBlock x:Name="BottomPendingRestartStateText"
                           Grid.Column="6"
                           Text="Pending restart: none" />
            </Grid>
        </Border>

    </Grid>
</wnd:AppWindow>
