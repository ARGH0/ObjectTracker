<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ObjectTracker.UI.Desktop.UsbCameraChoiceDialog"
        Title="Select USB Camera"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">

    <Grid RowDefinitions="*,Auto" Margin="18">

        <StackPanel Grid.Row="0" Spacing="14">

            <TextBlock Text="USB CAMERA" Classes="eyebrow" />

            <TextBlock Text="Select a USB camera for this Camera Zone."
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" />

            <ListBox x:Name="DeviceList"
                     MinHeight="120"
                     MaxHeight="240"
                     SelectionMode="Single"
                     Margin="0,0,0,8" />

            <TextBlock x:Name="StatusText"
                       Classes="muted"
                       TextWrapping="Wrap" />

        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,14,0,0">
            <Button x:Name="ConfirmButton"
                    Classes="primary"
                    Content="Select"
                    MinWidth="100" />
            <Button x:Name="CancelButton"
                    Classes="ghost"
                    Content="Cancel"
                    MinWidth="100" />
        </StackPanel>

    </Grid>
</Window>
