<wnd:AppWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:wnd="using:FluentAvalonia.UI.Windowing"
               xmlns:controls="clr-namespace:ObjectTracker.UI.Desktop"
               mc:Ignorable="d"
               x:Class="ObjectTracker.UI.Desktop.MainWindow"
               Title="ObjectTracker"
               Width="1920"
               Height="1080"
               MinWidth="1080"
               MinHeight="680"
               d:DesignWidth="1920"
               d:DesignHeight="1080">
    <DockPanel>
        <Panel DockPanel.Dock="Top">
        <Menu Margin="0,0,12,0"
              VerticalAlignment="Center"
              Background="Transparent">
            <MenuItem Header="Camera"
                      x:Name="CameraWorkspaceMenuItem">
                <MenuItem Header="Open Workspace"
                          x:Name="OpenCameraWorkspaceMenuItem" />
                <MenuItem Header="Clear Cameras"
                          x:Name="ClearCamerasMenuItem" />
            </MenuItem>
            <MenuItem Header="Layers"
                      x:Name="LayersWorkspaceMenuItem" />
            <MenuItem Header="Calibration"
                      x:Name="CalibrationWorkspaceMenuItem" />
            <MenuItem Header="Settings"
                      x:Name="SettingsWorkspaceMenuItem" />
            <MenuItem Header="Vision Pipeline"
                      x:Name="VisionPipelineMenuItem">
                <MenuItem Header="Start"
                          x:Name="StartVisionPipelineMenuItem" />
                <MenuItem Header="Stop"
                          x:Name="StopVisionPipelineMenuItem" />
            </MenuItem>
        </Menu>
        </Panel>

        <Panel DockPanel.Dock="Top">
            <controls:CameraWorkspace x:Name="CameraWorkspaceControl" />
            <controls:LayerWorkspace x:Name="LayerWorkspaceControl" IsVisible="False" />
            <controls:ColorCalibrationWorkspace x:Name="ColorCalibrationWorkspaceControl" IsVisible="False" />
            <controls:SettingsWorkspace x:Name="SettingsWorkspaceControl" IsVisible="False" />
        </Panel>

        <Panel DockPanel.Dock="Bottom">
            <Border>
                <Grid ColumnDefinitions="*,16,*,16,*,16,*">
                    <TextBlock x:Name="BottomVisionPipelineStateText"
                               Grid.Column="0"
                               Text="Vision Pipeline: stopped"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="BottomAmbiguityStateText"
                               Grid.Column="2"
                               Text="Ambiguity Alert: clear" />
                    <TextBlock x:Name="BottomCalibrationStateText"
                               Grid.Column="4"
                               Text="Calibration: unknown" />
                    <TextBlock x:Name="BottomPendingRestartStateText"
                               Grid.Column="6"
                               Text="Pending restart: none" />
                </Grid>
            </Border>
        </Panel>
    </DockPanel>
</wnd:AppWindow>
